# Environment
.env
*.env

# Python
__pycache__/
*.py[cod]
*.pyo
.Python
*.egg-info/
dist/
build/
.venv/
venv/
env/

# DuckDB databases (keep schema, not data files)
data/duckdb/*.duckdb
data/duckdb/*.duckdb.wal

# Raw data (large CSVs — download separately)
data/raw/
data/exports/

# dbt
dbt/target/
dbt/dbt_packages/
dbt/logs/

# Pipeline instrumentation reports (regenerated by scripts/pipeline_report.py)
reports/

# Terraform (aws/terraform/, gcp/terraform/) — provider cache and state; NOT
# .terraform.lock.hcl, which is committed on purpose so `terraform init` is
# reproducible.
aws/terraform/.terraform/
aws/terraform/*.tfstate
aws/terraform/*.tfstate.*
aws/terraform/*.tfplan
aws/terraform/.terraform.tfstate.lock.info
gcp/terraform/.terraform/
gcp/terraform/*.tfstate
gcp/terraform/*.tfstate.*
gcp/terraform/*.tfplan
gcp/terraform/.terraform.tfstate.lock.info

# IDE
.vscode/
.idea/
*.swp
*.swo

# macOS
.DS_Store

# Docker
docker/volumes/

# Streamlit
.streamlit/secrets.toml
