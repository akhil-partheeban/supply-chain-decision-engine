# Dashboard image. Reuses the same slim requirements.txt as the Streamlit Community
# Cloud deployment (root requirements.txt) — the dashboard's dependency set is
# identical in both places (streamlit, plotly, duckdb, pandas, python-dotenv), so
# there's no reason for a third requirements file here.
FROM python:3.12-slim

WORKDIR /app

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY dashboard/ dashboard/

EXPOSE 8501
CMD ["streamlit", "run", "dashboard/app.py", "--server.port=8501", "--server.address=0.0.0.0"]
