# DuckDB
DUCKDB_PATH=data/duckdb/supply_chain.duckdb

# UN Comtrade API
COMTRADE_API_KEY=your_comtrade_api_key_here
COMTRADE_BASE_URL=https://comtradeapi.un.org/data/v1

# World Bank
WORLD_BANK_BASE_URL=https://api.worldbank.org/v2

# Anthropic (for the decision agent — agent/decision_agent.py, direct SDK, not LangChain)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# OpenAI (legacy — no longer used by decision_agent)
OPENAI_API_KEY=your_openai_api_key_here

# FastAPI
API_HOST=0.0.0.0
API_PORT=8000
API_ENV=development

# Streamlit
STREAMLIT_PORT=8501

# AWS (data layer export + containerized API deployment — see aws/ and DECISIONS.md)
# Leave DUCKDB_S3_URI unset for local dev / docker compose: the API container falls
# back to the local DUCKDB_PATH file with no AWS calls at all.
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
DUCKDB_S3_URI=
